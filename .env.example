# ── Copy this file to .env and fill in values ─────────────────────────────────
# .env is gitignored and never committed.

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ───────────────────────────────────────────────────────────────────
# Set PRODUCTION=True on Render to switch from SQLite → PostgreSQL.
# Leave unset (or False) for local development — SQLite will be used.
PRODUCTION=False

# Only required when PRODUCTION=True.
# Render provides this automatically when you link a Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/dbname
