# ============================================================
#  GCIAP — Environment Variables EXAMPLE
#  Copy this file to .env and fill in your real values.
#  This file IS safe to commit to version control.
# ============================================================

# --- Django Core ---
SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── LOCAL DEVELOPMENT ─────────────────────────────────────────
# No DATABASE_URL needed — Django will use SQLite (db.sqlite3) automatically.

# ── PRODUCTION (Render.com) ───────────────────────────────────
# Add these as Environment Variables in your Render web service dashboard.
# Do NOT put real production secrets in this file.
#
# DATABASE_URL=postgres://user:password@dpg-xxxxx.oregon-postgres.render.com/gciap_db
# SECRET_KEY=a-long-random-production-secret-key
# DEBUG=False
# ALLOWED_HOSTS=your-app-name.onrender.com
